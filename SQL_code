----- CREATE DAILY NEW CASES (USING WINDOW FUNCTION) ---
/* 1. LAG(confirmed) → previous day confirmed
2. Subtraction → new cases per day
3. PARTITION BY state → calculated state-wise */ 

SELECT
    date,
    state_union_territory AS state,
    confirmed,
    confirmed - LAG(confirmed) OVER (
        PARTITION BY state_union_territory
        ORDER BY date
    ) AS daily_new_cases
FROM covid_19_india
ORDER BY state, date;


----- CREATE A PERMANENT VIEW ---
CREATE OR REPLACE VIEW daily_new_cases AS
SELECT
    date,
    state_union_territory AS state,
    confirmed,
    deaths,
    cured,
    COALESCE(
        confirmed - LAG(confirmed) OVER (
            PARTITION BY state_union_territory
            ORDER BY date
        ),
        0
    ) AS daily_new_cases
FROM covid_19_india;

SELECT *
FROM daily_new_cases
WHERE state = 'Maharashtra'
ORDER BY date;

---- India total daily cases ---
SELECT
    date,
    SUM(daily_new_cases) AS india_daily_cases
FROM daily_new_cases
GROUP BY date
ORDER BY date;

/* ---- Combine Indian + Foreign Confirmed Cases 
		Create a unified total_confirmed */ 
SELECT
    date,
    state_union_territory AS state,
    COALESCE(confirmed_indian_national, 0)
  + COALESCE(confirmed_foreign_national, 0) AS total_confirmed,
    deaths,
    cured
FROM covid_19_india;

/* Create Case Fatality Rate (CFR)
	Formula:(deaths / total_confirmed) * 100 */

SELECT
    date,
    state_union_territory AS state,
    total_confirmed,
    deaths,
    ROUND(
        (deaths::NUMERIC / NULLIF(total_confirmed, 0)) * 100,
        2
    ) AS case_fatality_rate
FROM (
    SELECT
        date,
        state_union_territory,
        COALESCE(confirmed_indian_national, 0)
      + COALESCE(confirmed_foreign_national, 0) AS total_confirmed,
        deaths
    FROM covid_19_india
) t;

/* CREATE CLEAN CASES VIEW */
CREATE OR REPLACE VIEW covid_cases AS
SELECT
    date,
    state_union_territory AS state,
    COALESCE(confirmed_indian_national, 0)
  + COALESCE(confirmed_foreign_national, 0) AS total_confirmed,
    deaths,
    cured,
    ROUND(
        (deaths::NUMERIC /
        NULLIF(
            COALESCE(confirmed_indian_national, 0)
          + COALESCE(confirmed_foreign_national, 0),
        0)) * 100,
        2
    ) AS case_fatality_rate
FROM covid_19_india;

/* CREATE CLEAN TESTING VIEW */

CREATE OR REPLACE VIEW covid_testing AS
SELECT
    date,
    state,
    total_samples,
    negative,
    positive
FROM statewise_testingdetails;


/* covid_cases and covid_testing table
	LEFT JOIN : keeps all case records */
SELECT
    c.date,
    c.state,
    c.total_confirmed,
    c.deaths,
    c.cured,
    c.case_fatality_rate,
    t.total_samples,
    t.positive,
    t.negative
FROM covid_cases c
LEFT JOIN covid_testing t
ON c.date = t.date
AND c.state = t.state
ORDER BY c.state, c.date;

/* CREATE FINAL ANALYTICS VIEW */
CREATE OR REPLACE VIEW covid_combined_analysis AS
SELECT
    c.date,
    c.state,
    c.total_confirmed,
    c.deaths,
    c.cured,
    c.case_fatality_rate,
    t.total_samples,
    t.positive,
    t.negative
FROM covid_cases c
LEFT JOIN covid_testing t
ON c.date = t.date
AND c.state = t.state;


/* CREATE CLEANED covid_summary TABLE
This table combines all three datasets.
Uses LEFT JOIN (no data loss)*/ 

DROP TABLE IF EXISTS covid_summary;

CREATE TABLE covid_summary AS
SELECT
    c.state_union_territory AS state,
    c.date,
    c.confirmed,
    c.deaths,
    c.cured,

    -- Daily new cases
    COALESCE(
        c.confirmed - LAG(c.confirmed) OVER (
            PARTITION BY c.state_union_territory
            ORDER BY c.date
        ),
        0
    ) AS daily_new_cases,

    -- Testing data
    t.total_samples,
    t.positive,

    -- Vaccination data
    v.first_dose,
    v.second_dose,

    -- Case Fatality Rate (CFR)
    ROUND(
        (c.deaths::NUMERIC / NULLIF(c.confirmed, 0)) * 100,
        2
    ) AS cfr

FROM covid_19_india c
LEFT JOIN statewise_testingdetails t
    ON c.date = t.date
   AND c.state_union_territory = t.state
LEFT JOIN covid_vaccine_statewise v
    ON c.date = v.updated_on
   AND c.state_union_territory = v.state;

/* ADD Positive_Test_Rate
Formula:(Positive / TotalSamples) * 100 */ 

ALTER TABLE covid_summary
ADD COLUMN positive_test_rate NUMERIC(5,2);

UPDATE covid_summary
SET positive_test_rate =
    ROUND(
        (positive::NUMERIC / NULLIF(total_samples, 0)) * 100,
        2
    );

/* ADD Vaccination_Rate
Population is not available in SQL, so we leave this column for Excel */ 

ALTER TABLE covid_summary
ADD COLUMN vaccination_rate NUMERIC(5,2);

/* CREATE Risk_Level COLUMN
Rules:
High Risk → CFR > 2 AND Positive Rate > 10
Medium Risk → One condition true
Low Risk → Both below */

ALTER TABLE covid_summary
ADD COLUMN risk_level TEXT;

UPDATE covid_summary
SET risk_level =
    CASE
        WHEN cfr > 2 AND positive_test_rate > 10
            THEN 'High Risk'
        WHEN cfr > 2 OR positive_test_rate > 10
            THEN 'Medium Risk'
        ELSE 'Low Risk'
    END;

